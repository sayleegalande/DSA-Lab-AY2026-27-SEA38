// Name: Saylee Galande
// Roll No: SEA038
// Searching Contact Name Using Sequential and Binary Search

#include <stdio.h>
#include <string.h>
#include <strings.h>

typedef struct contact
{
    char name[20];
    char phone[20];
    char address[20];
} contact;

int main()
{
    contact c[20];
    int n, i;
    int lincom = 0;
    int linfound = 0;
    int bincom = 0;
    char key[20];

    printf("Enter number of contacts: ");
    scanf("%d", &n);

    printf("\n---// ENTER CONTACT DETAILS (A-Z) //---\n");

    for (i = 0; i < n; i++)
    {
        printf("\n~~~ Contact %d ~~~\n", i + 1);

        printf("Name: ");
        scanf("%19s", c[i].name);

        printf("Contact: ");
        scanf("%19s", c[i].phone);

        printf("Address: ");
        scanf("%19s", c[i].address);
    }

    printf("\n---// DISPLAYING CONTACTS //---\n");

    for (i = 0; i < n; i++)
    {
        printf("\n~~~ Contact %d ~~~", i + 1);
        printf("\nName: %s", c[i].name);
        printf("\nContact: %s", c[i].phone);
        printf("\nAddress: %s\n", c[i].address);
    }

    printf("\n---// END //---\n");

    printf("\nEnter name of contact to search: ");
    scanf("%19s", key);

    // Linear Search
    printf("\n---// LINEAR SEARCH //---\n");

    for (i = 0; i < n; i++)
    {
        lincom++;

        if (strcasecmp(key, c[i].name) == 0)
        {
            printf("\nCONTACT FOUND");
            printf("\nName: %s", c[i].name);
            printf("\nContact: %s", c[i].phone);
            printf("\nAddress: %s\n", c[i].address);

            linfound = 1;
            break;
        }
    }

    if (linfound == 0)
    {
        printf("\nCONTACT NOT FOUND\n");
    }

    printf("Linear comparisons: %d\n", lincom);

    // Sort contacts alphabetically for Binary Search
    printf("\n---// BINARY SEARCH //---\n");

    char temp[20];

    for (i = 0; i < n; i++)
    {
        for (int j = 0; j < n - i - 1; j++)
        {
            if (strcasecmp(c[j].name, c[j + 1].name) > 0)
            {
                strcpy(temp, c[j].name);
                strcpy(c[j].name, c[j + 1].name);
                strcpy(c[j + 1].name, temp);
            }
        }
    }

    // Binary Search
    int high = n - 1;
    int low = 0;
    int mid;
    int binfound = 0;

    while (low <= high)
    {
        mid = (high + low) / 2;
        bincom++;

        if (strcasecmp(c[mid].name, key) == 0)
        {
            printf("\nContact found at location %d\n", mid + 1);
            binfound = 1;
            break;
        }
        else if (strcasecmp(c[mid].name, key) < 0)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    if (binfound == 0)
    {
        printf("\nContact not found\n");
    }

    printf("Number of binary comparisons: %d\n", bincom);

    return 0;
}
