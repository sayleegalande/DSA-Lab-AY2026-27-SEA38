#include <stdio.h>

int g[10][10], visited[10], n;

// Depth First Search (DFS)
void DFS(int v)
{
    int i;

    printf("%d ", v);
    visited[v] = 1;

    for (i = 0; i < n; i++)
    {
        if (g[v][i] && !visited[i])
        {
            DFS(i);
        }
    }
}

// Breadth First Search (BFS)
void BFS(int start)
{
    int q[10], front = 0, rear = 0;
    int i, v;

    for (i = 0; i < n; i++)
    {
        visited[i] = 0;
    }

    q[rear++] = start;
    visited[start] = 1;

    while (front < rear)
    {
        v = q[front++];
        printf("%d ", v);

        for (i = 0; i < n; i++)
        {
            if (g[v][i] && !visited[i])
            {
                q[rear++] = i;
                visited[i] = 1;
            }
        }
    }
}

